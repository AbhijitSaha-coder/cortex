# ==============================================================================
# Cortex AI Research & Knowledge Agent - Production Environment Configuration
# ==============================================================================

# Application & Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Cortex — AI Research & Knowledge Agent"
ENABLE_API_DOCS=true

# Security: Generate a strong 64-char hex key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_64_character_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated or JSON list)
# In production with Nginx reverse proxy, the frontend and API share the same origin.
# Add your Cloudflare domain or public hostname here if needed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL + pgvector)
# Use a strong password generated with: openssl rand -hex 16
POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=generate_a_secure_random_postgres_password

# For local non-Docker development:
# DATABASE_URL=sqlite:///./cortex.db

# Redis & Celery Workers
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
TASK_ALWAYS_EAGER=false

# AI Providers & Keys
# Options: "gemini" (Recommended free tier), "mock" (offline tests), "openai", "anthropic"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=gemini

# External Provider API Keys
# Gemini Free API Key can be generated for free at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional paid providers:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Embeddings Configuration
# For Gemini text-embedding-004, dimension is 768 (padded to 1536 for pgvector)
# For OpenAI text-embedding-3-small, dimension is 1536
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=1536

# Ingestion & Document Processing
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
RRF_K=60

# Port configuration (80 for standard web HTTP, or 5173)
PORT=80

# Cloudflare Tunnel Token (Optional - if using a named Cloudflare Tunnel)
# Leave blank if using a free ad-hoc tunnel: cloudflared tunnel --url http://localhost:80
CLOUDFLARE_TUNNEL_TOKEN=
