# Cortex AI Research & Knowledge Agent - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Local SQLite default (Zero-friction local dev & tests)
DATABASE_URL=sqlite:///./cortex.db
# PostgreSQL with pgvector (for Docker & Production)
# DATABASE_URL=postgresql://cortex:cortex_password@localhost:5432/cortex

# Redis & Celery Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TASK_ALWAYS_EAGER=true

# AI Reasoning Providers
# Options: "mock" (offline/free/deterministic), "openai", "gemini", "anthropic"
DEFAULT_LLM_PROVIDER=mock
DEFAULT_EMBEDDING_PROVIDER=mock

# External Provider API Keys (Leave blank when using "mock" mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
RRF_K=60
MAX_UPLOAD_SIZE_MB=25

